<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login</title>
    <style>
        html, body {
            height: 100%;
            overflow: hidden;
        }

        h3 {
          font-weight: normal;
          font-size: 20px;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: sans-serif;
        }

        .login-column {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 24px;
        }

        .form-grid {
          display: grid;
          grid-template-columns: auto 160px;
          gap: 8px 12px;
        }

        .login-button {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 6px 14px;
          color: #333;
          background-color: #f5f5f5;
          border: 1px solid #ddd;
          border-radius: 4px;
          text-decoration: none;
          font-size: 1rem;
          cursor: pointer;
        }

        .login-button svg {
          height: 1em;
        }

        .login-button:hover {
          background-color: #e3e3e3;
        }

        .login-button-primary {
          color: #fff;
          background-color: #3472f7;
          border-color: #3472f7;
        }

        .login-button-primary:hover {
          background-color: #1d62f0;
          border-color: #1d62f0;
        }

        .alert {
          background-color: lightpink;
          padding: 8px 4px;
          font-weight: bold;
          border: 1px solid red;
          border-radius: 4px;
        }
    </style>
</head>

<body>
  <main class="login-column">
    {{#if sessionMessage }}
      <div class="alert">
        {{sessionMessage}}
      </div>
    {{/if}}
    {{#if google }}
      <div>
        <h3>Google login</h3>
        <p>
            <a id="google-login-link" href="#"><img src="{{pathPrefix}}/assets/img/logo/google_signin.png" /></a>
        </p>
      </div>
    {{/if }}

    {{#if ldap }}
      <div>
        <h3>{{ pluginConfig.ldap.title }}</h3>
        <p>
            <form method="post" action="login/ldap" class="form-grid">
                <label for="ldap-username">Username</label>
                <input id="ldap-username" type="text" name="username" />
                <label for="ldap-password">Password</label>
                <input id="ldap-password" type="password" name="password" />
                <button type="submit" class="login-button">{{ pluginConfig.ldap.loginButtonText }}</button>
            </form>
        </p>
      </div>
    {{/if }}

    {{#if couchdb }}
      <div>
        <h3>{{ pluginConfig.couchdb.title }}</h3>
        <p>
            <form method="post" action="login/couchdb" class="form-grid">
                <label for="couchdb-username">Email</label>
                <input id="couchdb-username" type="text" name="username" />
                <label for="couchdb-password">Password</label>
                <input id="couchdb-password" type="password" name="password" />
                <button type="submit" class="login-button">{{ pluginConfig.couchdb.loginButtonText }}</button>
            </form>
        </p>
      </div>
    {{/if }}

    {{#if oidc }}
      <div>
        <h3>{{ pluginConfig.oidc.title }}</h3>
        <p>
          <a href="login/oidc" class="login-button login-button-primary">
            <!-- Font Awesome 4.7 "fa-sign-in" (same icon as the React app) -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1536 1792" fill="currentColor" aria-hidden="true">
              <path transform="matrix(1 0 0 -1 0 1536)" d="M1184 640q0 -26 -19 -45l-544 -544q-19 -19 -45 -19t-45 19t-19 45v288h-448q-26 0 -45 19t-19 45v384q0 26 19 45t45 19h448v288q0 26 19 45t45 19t45 -19l544 -544q19 -19 19 -45zM1536 992v-704q0 -119 -84.5 -203.5t-203.5 -84.5h-320q-13 0 -22.5 9.5t-9.5 22.5 q0 4 -1 20t-0.5 26.5t3 23.5t10 19.5t20.5 6.5h320q66 0 113 47t47 113v704q0 66 -47 113t-113 47h-288h-11h-13t-11.5 1t-11.5 3t-8 5.5t-7 9t-2 13.5q0 4 -1 20t-0.5 26.5t3 23.5t10 19.5t20.5 6.5h320q119 0 203.5 -84.5t84.5 -203.5z"/>
            </svg>
            {{ pluginConfig.oidc.loginButtonText }}
          </a>
        </p>
      </div>
    {{/if }}
  </main>
</body>
<script>
    if (window.name === 'loginPopup' && location.href.match(/auth\/login/i)) {
        window.close();
    }
    var google = document.getElementById('google-login-link');
    if (google) {
        google.onclick = function () {
            var url = 'login/google';
            doLogin(url);
        };
    }

    function doLogin(url) {
        if (window.parent !== window) {
            url += '/popup';
            var popup = window.open(url, 'loginPopup');
            var interval = setInterval(function () {
                if (popup.closed) {
                    clearInterval(interval);
                    window.location.reload();
                }
            }, 250)
        } else {
            window.location = url;
        }
    }
</script>

</html>
